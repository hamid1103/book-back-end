{
  "name": "fastify-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e ts --exec \"npm run build && npm start\"",
    "import:books": "tsc && node dist/scripts/importBooks.js",
    "assign:role": "tsc && node dist/scripts/assignRole.js",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "migration:generate": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.69.0",
    "@types/node": "^26.4.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": true,
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true
  }
}
